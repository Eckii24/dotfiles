  {
    "mason-org/mason.nvim",
    opts = {
      registries = {
        "github:mason-org/mason-registry",
      },
      ensure_installed = { "csharpier", "netcoredbg" },
    },
  },
  {
    "nvim-treesitter/nvim-treesitter",
    opts = { ensure_installed = { "c_sharp" } },
  },
  {
    "folke/snacks.nvim",
    optional = true,
    opts = function(_, opts)
      local explorer = opts.picker.sources.explorer
      explorer.win.list.keys["A"] = "explorer_add_dotnet"
      explorer.actions.explorer_add_dotnet = function(picker)
        local dir = picker:dir()
        local tree = require("snacks.explorer.tree")
        local actions = require("snacks.explorer.actions")

        require("easy-dotnet").create_new_item(dir, function(item_path)
          tree:open(dir)
          tree:refresh(dir)
          actions.update(picker, { target = item_path })
        end)
      end
    end,
  },
  {
    "stevearc/conform.nvim",
    optional = true,
    opts = {
      formatters_by_ft = {
        cs = { "csharpier" },
      },
      formatters = {
        csharpier = {
          command = "csharpier",
          args = { "format", "--stdin-path", "$FILENAME" },
        },
      },
    },
  },
  {
    "mfussenegger/nvim-dap",
    optional = true,
    opts = function()
      local dap = require("dap")
      if not dap.adapters["netcoredbg"] then
        require("dap").adapters["netcoredbg"] = {
          type = "executable",
          command = vim.fn.exepath("netcoredbg"),
          args = { "--interpreter=vscode" },
          options = {
            detached = false,
          },
        }
      end
      for _, lang in ipairs({ "cs", "fsharp", "vb" }) do
        if not dap.configurations[lang] then
          dap.configurations[lang] = {
            {
              type = "netcoredbg",
              name = "Launch file",
              request = "launch",
              ---@diagnostic disable-next-line: redundant-parameter
              program = function()
                return vim.fn.input("Path to dll: ", vim.fn.getcwd() .. "/", "file")
              end,
              cwd = "${workspaceFolder}",
            },
          }
        end
      end

      require("easy-dotnet.netcoredbg").register_dap_variables_viewer()
    end,
  },
  {
    "nvim-neotest/neotest",
    dependencies = {
      "GustavEikaas/easy-dotnet.nvim",
    },
    optional = true,
    opts = function(_, opts)
      table.insert(opts.adapters, require("easy-dotnet.neotest"))
    end,
  },
}
