          expand_node = { lhs = "E", desc = "expand node" },
          expand_all = { lhs = "O", desc = "expand all" },
          collapse_all = { lhs = "C", desc = "collapse all" },
          close = { lhs = "q", desc = "close testrunner" },
        },
      },
      picker = "snacks",
