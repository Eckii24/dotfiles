[include]
  path = config.local

[alias]
  lg1 = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)' --all
  lg2 = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold cyan)%aD%C(reset) %C(bold green)(%ar)%C(reset)%C(bold yellow)%d%C(reset)%n''          %C(white)%s%C(reset) %C(dim white)- %an%C(reset)' --all
  lg = !"git lg1"

[core]
  autocrlf = input
  editor = nvim
  pager = delta

[interactive]
  diffFilter = delta -n -s --color-only

[delta]
  line-numbers = true
  side-by-side = true
  navigate = true
  dark = true

[rebase]
  updateRefs = true
  autosquash = true

[diff]
  tool = diffview

[merge]
  tool = diffview
  conflictstyle = zdiff3

[difftool "diffview"]
  cmd = nvim -c "DiffviewDiffFiles \"$LOCAL\" \"$REMOTE\""

[mergetool "diffview"]
  cmd = nvim -c "DiffviewMergeFiles \"$MERGED\" \"$BASE\" \"$LOCAL\" \"$REMOTE\""
  trustExitCode = false

[rerere]
  ; This setting enables the automatic resolution of conflicts 
  ; using the recorded resolution of the same conflict.
  enabled = true

[filter "gitsqlite"]
  clean = gitsqlite clean
  smudge = gitsqlite smudge
[diff "gitsqlite"]
  textconv = gitsqlite diff
