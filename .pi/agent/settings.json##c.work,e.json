{
  "defaultThinkingLevel": "high",
  "defaultProvider": "github-copilot",
  "lastChangelogVersion": "0.84.0",
  "defaultModel": "gpt-5.6-luna",
  "modelTiers": {
    "small": "gpt-5.6-luna",
    "medium": "gpt-5.6-terra",
    "large": "gpt-5.6-sol"
  },
  "chatModel": "gpt-5.6-luna",
  "goal": {
    "maxTurns": 20,
    "evaluatorModel": "@small"
  },
  "compaction": {
    "enabled": true,
    "reserveTokens": 65536,
    "keepRecentTokens": 12000
  },
  "enableInstallTelemetry": false,
  "enableAnalystics": false,
  "packages": [],
  "npmCommand": [
    "bun"
  ],
  "guardrails": {
    "timeout": 300000,
    "paths": {
      "confirmRead": [
        "**/.env",
        "**/.env.*",
        "~/.ssh/**",
        "~/.gnupg/**",
        "~/.aws/**",
        "~/.config/gh/**",
        "~/.kube/**",
        "~/.pi/agent/auth.json",
        "~/.pi/agent/models.json",
        "**/.npmrc",
        "**/.pypirc",
        "**/.netrc",
        "**/*.pem",
        "**/*.key",
        "**/auth.json",
        "**/credentials.json",
        "**/secrets.json",
        "**/*secrets.zsh"
      ],
      "allowWrite": [
        "./**",
        "/tmp/**",
        "**/.ai/**",
        "~/.agents/**",
        "~/.pi/**"
      ],
      "confirmWrite": [
        "**/.env",
        "**/.env.*",
        "**/.git/**",
        "**/node_modules/**",
        "~/.pi/agent/auth.json",
        "~/.pi/agent/models.json",
        "~/.pi/agent/settings.json",
        "~/.pi/agent/guardrails.json",
        "**/.pi/settings.json",
        "**/.pi/guardrails.json",
        "**/.npmrc",
        "**/.pypirc",
        "**/.netrc",
        "**/*.pem",
        "**/*.key",
        "**/auth.json",
        "**/credentials.json",
        "**/secrets.json"
      ]
    },
    "bash": {
      "allow": [
        "pwd",
        "which",
        "ls",
        "cat",
        "head",
        "tail",
        "wc",
        "nl",
        "grep",
        "sort",
        "uniq",
        "cut",
        "paste",
        "tr",
        "strings",
        "xxd",
        "hexdump",
        "od",
        "file",
        "stat",
        "sha256sum",
        "shasum",
        "diff"
      ],
      "preflightModel": "@small",
      "preflightRules": [
        "When Gate 1 already allowed a sensitive path read, reading or displaying its contents is allowed; sensitive content alone is not a reason to confirm or deny.",
        "Allow local tests, builds, parsers, and scripts when command syntax shows no concrete write, network, privilege, remote-execution, or unrelated-system-state risk; do not infer risk merely because code could theoretically do more.",
        "Keep existing narrow safe HTTP(S) GET/HEAD allowlist behavior. Other remote calls require confirmation unless trusted task intent explicitly authorizes the exact destination and data transfer.",
        "An intentional sensitive upload may be allowed when trusted task intent explicitly authorizes it and command scope matches; otherwise require confirmation. Do not infer exfiltration from sensitive filenames or local data flow alone without visible outbound transfer syntax.",
        "Reading PI_* environment variables is allowed."
      ],
      "confirm": [
        "sudo",
        "chmod",
        "chown",
        "mkfs",
        "dd",
        "shutdown",
        "reboot",
        "poweroff",
        "halt",
        "kill",
        "killall",
        "pkill"
      ]
    }
  },
  "theme": "dark",
  "tuiMode": "fullscreen",
  "sandbox": {
    "mounts": {
      "readOnly": [
        {
          "hostPath": "/Users/matthias.eck/Development/Repos",
          "guestPath": "/repo-path",
          "required": true
        }
      ]
    },
    "environment": {
      "REPO_PATH": "/repo-path"
    }
  }
}
