{
  "defaultThinkingLevel": "high",
  "defaultProvider": "github-copilot",
  "defaultModel": "gpt-5.6-luna",
  "lastChangelogVersion": "0.84.2",
  "modelTiers": {
    "tiny": "github-copilot/gpt-5.6-luna",
    "small": "gpt-5.6-luna",
    "medium": "gpt-5.6-terra",
    "large": "gpt-5.6-sol"
  },
  "chatModel": "github-copilot/gpt-5.6-luna",
  "sessionTitle": {
    "model": "@tiny"
  },
  "goal": {
    "maxTurns": 20,
    "evaluatorModel": "@tiny"
  },
  "compaction": {
    "enabled": true,
    "reserveTokens": 65536,
    "keepRecentTokens": 12000
  },
  "enableInstallTelemetry": false,
  "enableAnalytics": false,
  "packages": [],
  "npmCommand": [
    "bun"
  ],
  "guardrails": {
    "timeout": 300000,
    "paths": {
      "confirmRead": [
        "**/.env",
        "**/.env.*",
        "~/.ssh/**",
        "~/.gnupg/**",
        "~/.aws/**",
        "~/.config/gh/**",
        "~/.kube/**",
        "~/.pi/agent/auth.json",
        "~/.pi/agent/models.json",
        "**/.npmrc",
        "**/.pypirc",
        "**/.netrc",
        "**/*.pem",
        "**/*.key",
        "**/auth.json",
        "**/credentials.json",
        "**/secrets.json",
        "**/*secrets.zsh"
      ],
      "allowWrite": [
        "./**",
        "/tmp/**",
        "**/.ai/**",
        "~/.agents/**",
        "~/.pi/**"
      ],
      "confirmWrite": [
        "**/.env",
        "**/.env.*",
        "**/.git/**",
        "**/node_modules/**",
        "~/.pi/agent/auth.json",
        "~/.pi/agent/models.json",
        "~/.pi/agent/settings.json",
        "~/.pi/agent/guardrails.json",
        "**/.pi/settings.json",
        "**/.pi/guardrails.json",
        "**/.npmrc",
        "**/.pypirc",
        "**/.netrc",
        "**/*.pem",
        "**/*.key",
        "**/auth.json",
        "**/credentials.json",
        "**/secrets.json"
      ]
    },
    "bash": {
      "allow": [
        "pwd",
        "which",
        "ls",
        "cat",
        "head",
        "tail",
        "wc",
        "nl",
        "grep",
        "sort",
        "uniq",
        "cut",
        "paste",
        "tr",
        "strings",
        "xxd",
        "hexdump",
        "od",
        "file",
        "stat",
        "sha256sum",
        "shasum",
        "diff"
      ],
      "preflightModel": "@tiny",
      "preflightRules": [],
      "confirm": [
        "sudo",
        "chmod",
        "chown",
        "mkfs",
        "dd",
        "shutdown",
        "reboot",
        "poweroff",
        "halt",
        "kill",
        "killall",
        "pkill",
        "az"
      ]
    }
  },
  "theme": "dark",
  "tuiMode": "fullscreen",
  "sandbox": {
    "mounts": {
      "readOnly": [
        {
          "hostPath": "/Users/matthias.eck/Development/Repos",
          "guestPath": "/repo-path",
          "required": true
        }
      ]
    },
    "environment": {
      "REPO_PATH": "/repo-path"
    }
  }
}