        {
          "command": [
            "pkill"
          ],
          "decision": "confirm"
        },
        {
          "command": [
            "az"
          ],
          "decision": "confirm"
        }
      ],
      "preflightModel": "@tiny",
      "preflightRules": []
    }
  },
  "theme": "dark",
  "tuiMode": "fullscreen"
}
