{
  "lastChangelogVersion": "0.84.2",
  "defaultThinkingLevel": "high",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-luna",
  "modelTiers": {
    "tiny": "gpt-5.6-luna",
    "small": "gpt-5.6-luna",
    "medium": "gpt-5.6-terra",
    "large": "gpt-5.6-sol"
  },
  "chatModel": "gpt-5.6-luna",
  "sessionTitle": {
    "model": "@tiny"
  },
  "goal": {
    "maxTurns": 20,
    "evaluatorModel": "@tiny"
  },
  "compaction": {
    "enabled": true,
    "reserveTokens": 65536,
    "keepRecentTokens": 12000
  },
  "enableInstallTelemetry": false,
  "enableAnalytics": false,
  "packages": [],
  "npmCommand": [
    "bun"
  ],
  "guardrails": {
    "timeout": 300000,
    "paths": {
      "confirmRead": [
        "**/.env",
        "**/.env.*",
        "~/.ssh/**",
        "~/.gnupg/**",
        "~/.aws/**",
        "~/.config/gh/**",
        "~/.kube/**",
        "~/.pi/agent/auth.json",
        "~/.pi/agent/models.json",
        "**/.npmrc",
        "**/.pypirc",
        "**/.netrc",
        "**/*.pem",
        "**/*.key",
        "**/auth.json",
        "**/credentials.json",
        "**/secrets.json",
        "**/*secrets.zsh"
      ],
      "allowWrite": [
        "./**",
        "/tmp/**",
        "**/.ai/**",
        "~/.agents/**",
        "~/.pi/**"
      ],
      "confirmWrite": [
        "**/.env",
        "**/.env.*",
        "**/.git/**",
        "**/node_modules/**",
        "~/.pi/agent/auth.json",
        "~/.pi/agent/models.json",
        "~/.pi/agent/settings.json",
        "~/.pi/agent/guardrails.json",
        "**/.pi/settings.json",
        "**/.pi/guardrails.json",
        "**/.npmrc",
        "**/.pypirc",
        "**/.netrc",
        "**/*.pem",
        "**/*.key",
        "**/auth.json",
        "**/credentials.json",
        "**/secrets.json"
      ]
    },
    "bash": {
      "rules": [
        {
          "command": [
            "pwd"
          ],
          "decision": "allow"
        },
        {
          "command": [
            "which"
          ],
          "decision": "allow"
        },
        {
          "command": [
            "ls"
          ],
          "decision": "allow"
        },
        {
          "command": [
            "cat"
          ],
          "decision": "allow"
        },
        {
          "command": [
            "head"
          ],
          "decision": "allow"
        },
        {
          "command": [
            "tail"
          ],
          "decision": "allow"
        },
        {
          "command": [
            "wc"
          ],
          "decision": "allow"
        },
        {
          "command": [
            "nl"
          ],
          "decision": "allow"
        },
        {
          "command": [
            "grep"
          ],
          "decision": "allow"
        },
        {
          "command": [
            "sort"
          ],
          "decision": "allow"
        },
        {
          "command": [
            "uniq"
          ],
          "decision": "allow"
        },
        {
          "command": [
            "cut"
          ],
          "decision": "allow"
        },
        {
          "command": [
            "paste"
          ],
          "decision": "allow"
        },
        {
          "command": [
            "tr"
          ],
          "decision": "allow"
        },
        {
          "command": [
            "strings"
          ],
          "decision": "allow"
        },
        {
          "command": [
            "xxd"
          ],
          "decision": "allow"
        },
        {
          "command": [
            "hexdump"
          ],
          "decision": "allow"
        },
        {
          "command": [
            "od"
          ],
          "decision": "allow"
        },
        {
          "command": [
            "file"
          ],
          "decision": "allow"
        },
        {
          "command": [
            "stat"
          ],
          "decision": "allow"
