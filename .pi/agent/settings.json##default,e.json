        },
        {
          "command": [
            "chmod"
          ],
          "decision": "confirm"
        },
        {
          "command": [
            "chown"
          ],
          "decision": "confirm"
        },
        {
          "command": [
            "mkfs"
          ],
          "decision": "confirm"
