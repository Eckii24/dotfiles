{
  "arch": "x86_64",
  "distro": "alpine",
  "container": {
    "force": true,
    "runtime": "docker"
  },
  "alpine": {
    "version": "3.23.0",
    "kernelPackage": "linux-virt",
    "kernelImage": "vmlinuz-virt",
    "rootfsPackages": [
      "linux-virt",
      "rng-tools",
      "bash",
      "coreutils",
      "ca-certificates",
      "curl",
      "e2fsprogs",
      "git",
      "openssh",
      "ripgrep",
      "findutils",
      "jq",
      "zsh",
      "nodejs",
      "npm",
      "python3",
      "py3-pip",
      "unzip",
      "build-base",
      "cargo",
      "rust",
      "musl-dev",
      "dotnet8-sdk",
      "dotnet9-sdk"
    ],
    "initramfsPackages": [],
    "krunfwVersion": "v5.2.1"
  },
  "rootfs": {
    "label": "gondolin-root"
  },
  "postBuild": {
    "copy": [
      {
        "src": "base-postbuild.sh",
        "dest": "/tmp/base-postbuild.sh"
      },
      {
        "src": "work-postbuild.sh",
        "dest": "/tmp/work-postbuild.sh"
      }
    ],
    "commands": [
      "sh /tmp/work-postbuild.sh"
    ]
  }
}
